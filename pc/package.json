{
  "name": "vento-pc",
  "productName": "ORDEVA",
  "version": "1.0.0",
  "description": "ORDEVA para PC: cuentas, pedidos, inventario, caja, balanza, impresora y cajón de tu negocio.",
  "author": "ORDEVA",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "co.vento.pc",
    "productName": "ORDEVA",
    "copyright": "ORDEVA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "sin-internet.html",
      "icono.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icono.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORDEVA",
      "artifactName": "Vento-Setup.${ext}",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icono.png",
      "category": "Office",
      "artifactName": "Vento.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/cristhianlujan45-blip/ORDEVA/releases/download/pc"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icono.png",
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "ORDEVA-Mac.${ext}"
    },
    "dmg": {
      "title": "ORDEVA",
      "artifactName": "ORDEVA-Mac.${ext}"
    },
    "executableName": "Vento"
  }
}
